# setup-dev-env.ps1 (v2 - Corrected)
#
# 这个脚本使用 winget 自动安装 Python, Node.js, Java SDK 和 C++ Build Tools,
# 并配置必要的环境变量。修复了语法错误并增强了稳定性。

# 1. 检查并请求管理员权限
if (-NOT ([Security.Principal.WindowsPrincipal][Security.Principal.WindowsIdentity]::GetCurrent()).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
    Write-Host "需要管理员权限来安装软件和修改环境变量。" -ForegroundColor Yellow
    Write-Host "正在尝试以管理员身份重新启动脚本..." -ForegroundColor Cyan
    # 为确保脚本内容被完整传递，最好是先下载再执行
    $scriptPath = Join-Path $env:TEMP "setup-dev-env.ps1"
    (New-Object Net.WebClient).DownloadFile("https://gist.githubusercontent.com/manus-team/a7b633c69228510a7b6a7356b45d9e83/raw/setup-dev-env.ps1", $scriptPath)
    Start-Process powershell.exe -Verb RunAs -ArgumentList ("-NoProfile -ExecutionPolicy Bypass -File `"{0}`"" -f $scriptPath)
    exit
}

# 如果已经是以管理员身份运行，则继续
Write-Host "脚本已在管理员模式下运行。" -ForegroundColor Green
Write-Host "----------------------------------------------------"
Write-Host "开发环境自动安装脚本 (v2)"
Write-Host "----------------------------------------------------"
Write-Host "即将安装: Python 3.13, Node.js 22, OpenJDK 22, C++ Build Tools"
Write-Host "注意：安装过程可能需要较长时间，请耐心等待..." -ForegroundColor Magenta
Write-Host "----------------------------------------------------"

# 检查 winget 是否可用
try {
    winget --version -h > $null
    Write-Host "检测到 winget 可用。" -ForegroundColor Green
} catch {
    Write-Error "错误: 'winget' 命令未找到。请确保已从 Microsoft Store 安装 'App Installer'。"
    Read-Host "按 Enter 键退出。"
    exit 1
}

# 定义安装函数
function Install-Package {
    param (
        [string]$Name,
        [string]$Id,
        [string]$Version,
        [string]$ExtraArgs
    )

    Write-Host "`n正在处理: $Name" -ForegroundColor Cyan
    
    # 检查是否已安装
    $listOutput = winget list --id $Id --source winget --accept-source-agreements 2>$null
    if ($listOutput -match $Id) {
        Write-Host "$Name 已安装，跳过。" -ForegroundColor Yellow
        return
    }

    Write-Host "开始安装 $Name (ID: $Id)..." -ForegroundColor Green
    $command = "winget install --id $Id --accept-package-agreements --accept-source-agreements --source winget --silent"
    if ($Version) { $command += " --version $Version" }
    if ($ExtraArgs) { $command += " $ExtraArgs" }

    Write-Host "执行命令: $command"
    try {
        Invoke-Expression $command
        if ($LASTEXITCODE -eq 0) {
            Write-Host "$Name 安装成功。" -ForegroundColor Green
        } else {
            # 某些安装程序即使成功也会返回非零代码，这里只作为警告
            Write-Warning "$Name 安装过程返回了非零退出代码: $LASTEXITCODE。这不一定代表失败。"
        }
    } catch {
        Write-Error "$Name 安装过程中出现严重错误: $_"
    }
}

# 2. 安装指定的软件
Install-Package -Name "Python 3.13" -Id "Python.Python.3.13"
Install-Package -Name "Node.js LTS" -Id "OpenJS.NodeJS.LTS"
Install-Package -Name "Microsoft OpenJDK 22" -Id "Microsoft.OpenJDK.22"
Install-Package -Name "Visual Studio 2022 Build Tools" -Id "Microsoft.VisualStudio.2022.BuildTools" -ExtraArgs '--override "--quiet --wait --add Microsoft.VisualStudio.Workload.NativeDesktop --includeRecommended"'

# 3. 配置环境变量
Write-Host "`n----------------------------------------------------"
Write-Host "正在配置环境变量..." -ForegroundColor Cyan

try {
    # 设置 JAVA_HOME
    $JavaInstallDir = Get-Item -Path "C:\Program Files\Microsoft\jdk-22*" -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending | Select-Object -First 1
    if ($JavaInstallDir -and (Test-Path $JavaInstallDir.FullName)) {
        $JavaHomePath = $JavaInstallDir.FullName
        Write-Host "检测到 Java 安装路径: $JavaHomePath" -ForegroundColor Green
        
        [System.Environment]::SetEnvironmentVariable('JAVA_HOME', $JavaHomePath, [System.EnvironmentVariableTarget]::Machine)
        Write-Host "系统环境变量 'JAVA_HOME' 已设置。"

        # 将 JAVA_HOME\bin 添加到系统 PATH
        $JavaBinPath = Join-Path $JavaHomePath "bin"
        $MachinePath = [System.Environment]::GetEnvironmentVariable('Path', [System.EnvironmentVariableTarget]::Machine)
        
        if (-not $MachinePath.ToLower().Contains($JavaBinPath.ToLower())) {
            $NewMachinePath = $MachinePath + ";" + $JavaBinPath
            [System.Environment]::SetEnvironmentVariable('Path', $NewMachinePath, [System.EnvironmentVariableTarget]::Machine)
            Write-Host "Java bin 目录已添加到系统 PATH。"
            # 同时更新当前会话的 PATH
            $env:Path = $NewMachinePath
        } else {
            Write-Host "Java bin 目录已存在于系统 PATH 中。"
        }
    } else {
        Write-Warning "未找到 OpenJDK 22 的安装目录，请在安装完成后手动设置 JAVA_HOME 环境变量。"
    }
} catch {
    Write-Error "配置环境变量时发生错误: $_"
}

Write-Host "----------------------------------------------------"
Write-Host "所有任务已完成！" -ForegroundColor Green
Write-Host "重要提示: 请关闭并重新打开一个新的命令行窗口(CMD 或 PowerShell)以使所有更改完全生效。"
Read-Host "按 Enter 键退出脚本。"
