# install-dev-env.ps1
# 先确保 winget 存在，再静默安装 Python / Node.js / JDK / C++ 并配置环境变量
$ErrorActionPreference = 'Stop'

# 0 若系统无 winget，先装 App Installer（含 winget）
if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
    Write-Host '>>> 正在安装 winget ...' -ForegroundColor Green
    $appInstallerUrl = 'https://aka.ms/Microsoft.VCLibs.x64.14.00.Desktop.appx'
    $wingetUrl       = 'https://github.com/microsoft/winget-cli/releases/latest/download/Microsoft.DesktopAppInstaller_8wekyb3d8bbwe.msixbundle'
    Invoke-WebRequest -Uri $appInstallerUrl -OutFile "$env:TEMP\VCLibs.appx" -UseBasicParsing
    Invoke-WebRequest -Uri $wingetUrl       -OutFile "$env:TEMP\winget.msixbundle" -UseBasicParsing
    Add-AppxPackage "$env:TEMP\VCLibs.appx"
    Add-AppxPackage "$env:TEMP\winget.msixbundle"
}

function Add-MachinePath {
    param([string]$NewPath)
    $cur = [Environment]::GetEnvironmentVariable('Path','Machine')
    if ($cur -split ';' -notcontains $NewPath) {
        [Environment]::SetEnvironmentVariable('Path', "$cur;$NewPath", 'Machine')
    }
}

# 1 Python
winget install --id Python.Python.3.13 -e --accept-source-agreements --accept-package-agreements --silent
Add-MachinePath 'C:\Program Files\Python313\Scripts'
Add-MachinePath 'C:\Program Files\Python313'

# 2 Node.js
winget install --id OpenJS.NodeJS -e --accept-source-agreements --accept-package-agreements --silent
Add-MachinePath 'C:\Program Files\nodejs'

# 3 JDK 21
winget install --id Oracle.JDK.21 -e --accept-source-agreements --accept-package-agreements --silent
$jdk = Get-ChildItem 'C:\Program Files\Java\jdk-*' | Sort-Object LastWriteTime -Descending | Select-Object -First 1 -Expand FullName
[Environment]::SetEnvironmentVariable('JAVA_HOME', $jdk, 'Machine')
Add-MachinePath "$jdk\bin"

# 4 C++ 编译器（VS Build Tools 2022 + MSVC v143 + Windows 11 SDK）
winget install --id Microsoft.VisualStudio.2022.BuildTools -e --accept-source-agreements --accept-package-agreements --silent --override '--wait --quiet --add Microsoft.VisualStudio.Workload.VCTools --add Microsoft.VisualStudio.Component.Windows11SDK.22621'

# 5 立即刷新当前会话
$env:Path        = [Environment]::GetEnvironmentVariable('Path','Machine')
$env:JAVA_HOME   = [Environment]::GetEnvironmentVariable('JAVA_HOME','Machine')

# 6 验证
python --version
node   -v
npm    -v
java   -version
javac  -version
cl     2>&1|Select-Object -First 1
